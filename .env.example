# Base de datos (DIRECT_URL opcional: conexión directa para migraciones en Vercel; en local no se usa)
DATABASE_URL="postgresql://compras:compras@localhost:5432/compras"
DIRECT_URL="postgresql://compras:compras@localhost:5432/compras"
# Secreto para firmar sesiones (generar con: openssl rand -hex 32)
AUTH_SECRET="cambiar-por-un-secreto-largo"
# URL pública con la que los proveedores abren el portal (en Vercel, si se deja vacía se usa el dominio del proyecto)
APP_URL="http://localhost:3000"
# Adjuntos: "disk" (carpeta UPLOAD_DIR) o "db" (dentro de PostgreSQL; por defecto en Vercel)
STORAGE_DRIVER="disk"
UPLOAD_DIR="./data/uploads"
# Correo SMTP (si SMTP_HOST está vacío, los correos solo se registran en la bitácora)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="Compras Grupo AG <compras@grupoag.com>"
# Recordatorios automáticos: horas antes del cierre, separados por coma
REMINDER_HOURS="48,4"
CRON_SECRET=""
COOKIE_SECURE="false"
